[global]
pid = {{bamp_root}}/data/php/php-fpm.pid
error_log = {{bamp_root}}/data/logs/php_error.log

[www]
user = nobody
group = nobody
listen = {{fastcgi_pass}}
pm = dynamic
pm.max_children = 10
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3
clear_env = no
catch_workers_output = yes
php_admin_value[error_log] = {{bamp_root}}/data/logs/php_fpm_error.log
php_admin_flag[log_errors] = on
